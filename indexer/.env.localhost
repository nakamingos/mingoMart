# Local chain profile: `yarn start:localhost`
#
# Points the indexer at a local Anvil chain (chain ID 1337) and your LOCAL Supabase.
# Loaded after .env, and .env wins for any key set in both (SUPABASE_*, NODE_ENV, PORT, QUEUE...).
# The indexer refuses to start on chain 1337 unless SUPABASE_URL is local and NODE_ENV=development.
#
# Local data goes into the *_sepolia tables (any non-mainnet chain does), keeping it separate from
# the mainnet backfill in your local database.
#
# Everything here is public: Anvil's default test accounts and made-up API keys.
# Never put a real key or a real RPC URL in this file; it is committed.
#
# Start the chain:   anvil --chain-id 1337
# Deploy contracts:  (cd ../contracts && npx hardhat run scripts/deploy-mingomart-market.ts --network localhost)
# The contract addresses below are what that deploy produces as the first thing run on a fresh
# Anvil chain; the deploy script prints them so you can check.

NODE_ENV="development"
PORT=3003
ALLOWED_ORIGINS=http://localhost:4200

# FEATURES
QUEUE=1
BRIDGE=0
DISCORD=0
TWITTER=0
TELEGRAM=0
TX_POOL=0
MINT=0

# CHAIN
CHAIN_ID_L1=1337
CHAIN_ID_L2=6969696969
BRIDGE_BLOCK_DELAY=1
RPC_URL_L1=http://127.0.0.1:8545
# L2 is unused locally (BRIDGE=0) but required by config.
RPC_URL_L2=http://127.0.0.1:8545

# CONTRACTS (fresh-chain deploy addresses; zero = not deployed locally)
MARKET_ADDRESS_L1=0x9fe46736679d2d9a65f0992f2272de9f3c7fa6e0
POINTS_ADDRESS_L1=0x5fbdb2315678afecb367f032d93f642f64180aa3
MARKET_ADDRESS_L2=0x0000000000000000000000000000000000000000
POINTS_ADDRESS_L2=0x0000000000000000000000000000000000000000
BRIDGE_ADDRESS_L1=0x0000000000000000000000000000000000000000
BRIDGE_ADDRESS_L2=0x0000000000000000000000000000000000000000
AUCTION_HOUSE_ADDRESS_L1=0x0000000000000000000000000000000000000000

# RELAYER: Anvil account #9 (public test key)
RELAY_SIGNER_ADDRESS_L1=0xa0Ee7A142d267C1f36714E4a8F75612F20a79720
RELAY_SIGNER_PK_L1=2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6
RELAY_SIGNER_ADDRESS_L2=0xa0Ee7A142d267C1f36714E4a8F75612F20a79720
RELAY_SIGNER_PK_L2=2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6

# API KEYS (local only)
API_PRIVATE_KEY=local-private-key
API_PUBLIC_KEY=local-public-key
